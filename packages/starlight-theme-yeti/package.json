    "./components/*": "./components/*",
    "./styles/*": "./styles/*",
    "./assets/*": "./assets/*"
  },
  "peerDependencies": {
    "@astrojs/starlight": "^0.41.0",
    "astro": "^7.0.0",
    "astro-icon": "^1.1.0",

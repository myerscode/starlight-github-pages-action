{
  "name": "@myerscode/starlight-theme-yeti",
  "version": "0.1.0",
  "type": "module",
  "description": "A clean, modern Starlight theme with Tailwind CSS styling, icon support, and collapsible linked sidebar groups.",
  "license": "MIT",
  "keywords": [
    "starlight",
    "astro",
    "theme",
    "tailwind",
    "documentation"
  ],
  "exports": {
    ".": "./index.ts",

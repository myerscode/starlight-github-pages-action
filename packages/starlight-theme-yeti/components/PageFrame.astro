---
import MobileMenuToggle from "virtual:starlight/components/MobileMenuToggle";
---

<div class="flex min-h-screen flex-col">
  <header class="sticky top-0 z-50 flex h-16 items-center border-b border-slate-200 bg-white/90 px-4 backdrop-blur-md dark:border-slate-800 dark:bg-slate-950/90">
    <slot name="header" />
  </header>
  <div class="flex flex-1">
    <nav class="hidden w-64 shrink-0 border-r border-slate-200 dark:border-slate-800 md:block" aria-label="Main">
      <MobileMenuToggle {...Astro.props} />
      <div id="starlight__sidebar" class="sticky top-16 h-[calc(100vh-4rem)] overflow-y-auto">
        <slot name="sidebar" />
      </div>
    </nav>
    <div class="min-w-0 flex-1">
      <slot />
    </div>
  </div>
</div>

---
const { editUrl } = Astro.locals.starlightRoute;
---

{editUrl && (
  <a href={editUrl.href} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 text-sm text-slate-500 no-underline transition-colors hover:text-slate-900 dark:text-slate-400 dark:hover:text-white">
    <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" />
      <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" />
    </svg>
    Edit page
  </a>
)}

---
---

<starlight-theme-select>
  <div class="theme-toggle">
    <button type="button" data-theme-value="auto" aria-label="System theme" class="theme-option">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="2" y="3" width="20" height="14" rx="2" ry="2" />
        <line x1="8" y1="21" x2="16" y2="21" />
        <line x1="12" y1="17" x2="12" y2="21" />
      </svg>
    </button>
    <button type="button" data-theme-value="light" aria-label="Light theme" class="theme-option">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="5" />
        <line x1="12" y1="1" x2="12" y2="3" />
        <line x1="12" y1="21" x2="12" y2="23" />
        <line x1="4.22" y1="4.22" x2="5.64" y2="5.64" />
        <line x1="18.36" y1="18.36" x2="19.78" y2="19.78" />
        <line x1="1" y1="12" x2="3" y2="12" />
        <line x1="21" y1="12" x2="23" y2="12" />
        <line x1="4.22" y1="19.78" x2="5.64" y2="18.36" />
        <line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />
      </svg>
    </button>
    <button type="button" data-theme-value="dark" aria-label="Dark theme" class="theme-option">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
      </svg>
    </button>
  </div>
</starlight-theme-select>

<style>
  .theme-toggle {
    display: flex;
    align-items: center;
    gap: 0.125rem;
    padding: 0.25rem;
    border-radius: 9999px;
    border: 1px solid var(--sl-color-gray-5);
    background: var(--sl-color-gray-6);
  }

  .theme-option {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.375rem;
    border-radius: 9999px;
    border: none;
    background: transparent;
    color: var(--sl-color-gray-3);
    cursor: pointer;
    transition: color 0.15s, background-color 0.15s;
  }

  .theme-option:hover {
    color: var(--sl-color-white);
  }

  .theme-option.active {
    background: var(--sl-color-gray-4);
    color: var(--sl-color-white);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.1);
  }
</style>

<script>
  class ThemeToggle extends HTMLElement {
    constructor() {
      super();
      const buttons = this.querySelectorAll<HTMLButtonElement>('.theme-option');
      const stored = localStorage.getItem('starlight-theme') || 'auto';
      this.setActive(stored);

      buttons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const value = btn.dataset.themeValue!;
          this.setActive(value);
          localStorage.setItem('starlight-theme', value);

          if (value === 'auto') {
            const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
            document.documentElement.dataset.theme = prefersDark ? 'dark' : 'light';
          } else {
            document.documentElement.dataset.theme = value;
          }
        });
      });
    }

    setActive(value: string) {
      this.querySelectorAll<HTMLButtonElement>('.theme-option').forEach((btn) => {
        btn.classList.toggle('active', btn.dataset.themeValue === value);
      });
    }
  }

  customElements.define('starlight-theme-select', ThemeToggle);
</script>
